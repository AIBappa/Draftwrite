# Temporary Office files
~$*
*.tmp

# OS files
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo

# Ignore runtime data contents, but keep empty folders via .gitkeep
sessions/*
exports/*
saved_exports/*
keys/*
Code/sessions/*
Code/saved_exports/*

# Allow .gitkeep files to be tracked
sessions/.gitkeep
saved_exports/.gitkeep
keys/.gitkeep

#Agentic scripts folder
/Code/AI_scripts/
payload.json

#Ignore python files
*.pyc
__pycache__/
*.py[cod]
*$py.class
